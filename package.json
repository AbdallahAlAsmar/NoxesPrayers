{
  "name": "muslim-prayer-reminder-community-discord-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Private prayer reminders and opt-in community streaks for Discord",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:format": "prisma format",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "commands:deploy": "tsx src/commands/deploy.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "adhan": "^4.4.6",
    "discord.js": "^14.25.1",
    "dotenv": "^16.4.7",
    "luxon": "^3.7.2",
    "pg": "^8.16.3",
    "pino": "^9.9.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "prisma": "^7.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
